# Copy to .env and fill in what you need. Every variable is optional.

# Port of the local admin (http://localhost:<PORT>). Default: 4321
PORT=

# Set to 1 to stop the admin from opening a browser window on start.
NO_OPEN=

# Folder that holds the gallery data (data/, docs/, drafts/) and its git repository.
# Default: this project folder. `npm run demo` uses ./demo-data instead.
GALLERY_DATA_ROOT=

# Language used to sort collection and group names, e.g. en, cs, de. Default: en
GALLERY_LOCALE=
